# API
NODE_ENV=development
PORT=8082
AUTH_DISABLED=true
ADMIN_USER_UUID=00000000-0000-0000-0000-000000000001

# Database
DATABASE_URL=postgres://esat:esat@localhost:5435/esat_db

# Extractor service (Python FastAPI)
EXTRACTOR_URL=http://localhost:8081

# Storage
STORAGE_DIR=./storage

# Gemini via Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Auth (Phase 6)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
COOKIE_SECURE=false
# Comma-separated allowlist for new-user signup. Existing users are
# always allowed. Leave empty to permit any verified Google email.
ALLOWED_EMAILS=
# Public URL the API is reachable at (used for OAuth redirect_uri).
# Falls back to the request's host header when unset.
PUBLIC_URL=
# Frontend URL the OAuth callback redirects back to after success/failure.
FRONTEND_URL=http://localhost:5173

# Ingest API key (for bulk upload script)
INGEST_API_KEY=dev-ingest-key

# Frontend (Vite — prefix with VITE_ to expose)
VITE_API_URL=http://localhost:8082
